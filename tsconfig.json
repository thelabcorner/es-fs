{
  "compilerOptions": {
    "target": "ES5",
    "module": "ESNext",
    "strict": true,
    "noEmit": true,
    "lib": ["ES5", "ES2015", "ES2017", "ES2020"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "noImplicitAny": true
  },
  "include": ["src/core.ts", "src/index.ts", "src/types.ts"]
}
