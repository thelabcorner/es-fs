{
  "name": "esfs",
  "version": "0.1.0",
  "description": "Synchronous, byte-aware File and Folder operations for Adobe ExtendScript (ES3)",
  "type": "module",
  "main": "dist/esfs-core.esm.mjs",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/ESFS.jsx",
    "dist/esfs-core.esm.mjs",
    "dist/types/",
    "dist/native/release/ESFSNative.dll",
    "deps/esabi/",
    "native/",
    "scripts/",
    "src/",
    "tests/benchmark-file-io.jsx",
    "tests/native-probe.jsx",
    "tests/benchmark-native.jsx",
    "tests/native-live.mjs",
    "tests/benchmark-native-live.mjs",
    "tests/release-package-live.mjs",
    "extendscript.estc.config.mjs",
    "tsconfig.json",
    "tsconfig.types.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esfs-core.esm.mjs"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "native:build": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "native:build:check": "npm run native:build && node ../extendscript-toolchain/bin/estc.mjs check tests/native-probe.jsx tests/benchmark-native.jsx --no-target",
    "native:live:check": "node ../extendscript-toolchain/bin/estc.mjs check tests/native-probe.jsx tests/benchmark-native.jsx --no-target --live",
    "native:live:probe": "node tests/native-live.mjs",
    "native:release:live": "node tests/release-package-live.mjs",
    "native:benchmark": "node tests/benchmark-native-live.mjs",
    "build:core": "node scripts/build.mjs --core",
    "test": "npm run build:core && node --test tests/esfs.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "estc:static": "node ../extendscript-toolchain/bin/estc.mjs check dist/ESFS.jsx tests/benchmark-file-io.jsx --no-target",
    "verify": "npm run typecheck && npm run build && npm run estc:static && npm test",
    "verify:engine": "node ../extendscript-toolchain/bin/estc.mjs check dist/ESFS.jsx tests/benchmark-file-io.jsx --no-target --live",
    "benchmark:static": "node ../extendscript-toolchain/bin/estc.mjs check tests/benchmark-file-io.jsx --no-target"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/thelabcorner/es-fs.git"
  }
}
